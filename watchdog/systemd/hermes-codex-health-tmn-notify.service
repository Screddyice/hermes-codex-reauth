[Unit]
Description=Escalate over Telegram when the Team Nebula Hermes codex check cannot report

[Service]
Type=oneshot
EnvironmentFile=-%h/.hermes/profiles/tmn/.env
EnvironmentFile=-%h/.hermes/.env
ExecStart=/usr/bin/python3 %h/.hermes/profiles/tmn/codex-health/notify_failure.py --unit hermes-codex-health-tmn.service
TimeoutStartSec=120
