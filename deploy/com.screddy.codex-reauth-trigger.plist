<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.screddy.codex-reauth-trigger</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/screddy/projects/Screddyice/openclaw-codex-reauth/deploy/mac-reauth-trigger.py</string>
    </array>

    <!-- aws is needed on PATH for the EC2 Instance Connect ProxyCommand (neb/cliqk SSH). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Hourly. Reactive: does nothing unless a server's reauth flag is set. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/screddy/.openclaw-oauth/mac-reauth-trigger.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/screddy/.openclaw-oauth/mac-reauth-trigger.launchd.log</string>
</dict>
</plist>
